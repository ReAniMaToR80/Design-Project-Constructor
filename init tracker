import os
import openpyxl
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side

def create_divided_tracker():
    base_dir = r"C:\Project\bs_constructor"
    db_dir = os.path.join(base_dir, "database")
    file_path = os.path.join(db_dir, "main_tracker.xlsx")
    
    if not os.path.exists(db_dir):
        os.makedirs(db_dir)
        
    wb = openpyxl.Workbook()
    
    # -------------------------------------------------------------------------
    # ВКЛАДКА 1: ТОЛЬКО ПИР (Ваше основное проектное ядро)
    # -------------------------------------------------------------------------
    ws_pir = wb.active
    ws_pir.title = "PIR_Core"
    
    pir_headers = [
        "№", "Operator", "Site_ID", "Site_Name", "Region", "Address_Fact",
        "Date_PPO", "PPO_Result", "Status_PTR_OTR", "Date_Approval_Operator", 
        "Contract_Number", "Stage_PIR", "Status_ID", "Closing_Volume", "Comments_GIP"
    ]
    ws_pir.append(pir_headers)
    
    # Реальный боевой пример МТС Орово
    ws_pir.append([
        1, "MTS", "78-04546", "Orovo", "LO", "Vsevolozhsky r-n, d. Orovo", 
        "12.06.2026", "Technical_Possible", "In_Progress", "-", 
        "Dog-MTS-2026", "AOP_Stage", "Not_Started", "Open", "Опора ОДН Русмаркет. Запускаем Квен!"
    ])

    # -------------------------------------------------------------------------
    # ВКЛАДКА 2: СМР и СДАЧА (Контроль стройки, изолированный от проектирования)
    # -------------------------------------------------------------------------
    ws_smr = wb.create_sheet(title="SMR_Control")
    
    smr_headers = [
        "№", "Site_ID", "Operator", "Status_SMR", "Date_Start_SMR", 
        "Date_Finish_SMR", "Position_Ready", "On_Air_Date", "Comments_SMR"
    ]
    ws_smr.append(smr_headers)
    ws_smr.append([1, "78-04546", "MTS", "Planned", "-", "-", "No", "-", "Ожидание выдачи РД в производство"])

    # --- СТИЛИЗАЦИЯ И СЕТКА ---
    header_font = Font(name="Arial", size=10, bold=True, color="FFFFFF")
    fill_pir = PatternFill(start_color="1F4E78", end_color="1F4E78", fill_type="solid") # Синий для ПИР
    fill_smr = PatternFill(start_color="5B5B5B", end_color="5B5B5B", fill_type="solid") # Серый для СМР
    
    thin_border = Border(
        left=Side(style='thin', color='D9D9D9'), right=Side(style='thin', color='D9D9D9'),
        top=Side(style='thin', color='D9D9D9'), bottom=Side(style='thin', color='D9D9D9')
    )
    
    for sheet, fill in [(ws_pir, fill_pir), (ws_smr, fill_smr)]:
        # Оформляем шапку
        for col in range(1, sheet.max_column + 1):
            cell = sheet.cell(row=1, column=col)
            cell.font = header_font
            cell.fill = fill
            cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
            
        # Настраиваем сетку и обычное выравнивание для данных
        for row in sheet.iter_rows(min_row=2, max_row=sheet.max_row, min_col=1, max_col=sheet.max_column):
            for cell in row:
                cell.font = Font(name="Arial", size=10)
                cell.border = thin_border
                cell.alignment = Alignment(horizontal="left", vertical="center")
                    
        # ИСПРАВЛЕННЫЙ БЛОК: Выставляем автоматическую ширину колонок без AttributeError
        for col in sheet.columns:
            max_len = max(len(str(cell.value or '')) for cell in col)
            # Берем индекс колонки от первой ячейки в кортеже col[0]
            col_index = col[0].column 
            col_letter = openpyxl.utils.get_column_letter(col_index)
            sheet.column_dimensions[col_letter].width = max(max_len + 3, 11)
            
    wb.save(file_path)
    print(f"[Успешно]: Раздельный трекер создан! Ошибок больше нет.\nПуть: {file_path}")

if __name__ == "__main__":
    create_divided_tracker()

