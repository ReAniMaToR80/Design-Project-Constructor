import os
import openpyxl
import json
import urllib.request

def build_autocad_scr(site_id, operator, address):
    """Модуль генерации .scr сценария для AutoCAD"""
    output_dir = r"C:\Project\bs_constructor\output"
    scr_path = os.path.join(output_dir, f"draw_layout_{site_id}.scr")
    
    if not os.path.exists(output_dir):
        os.makedirs(output_dir)
        
    # Базовые ГОСТовские команды для Акада под шрифты ISOCPEUR
    script_commands = [
        "; === СКРИПТ АВТОМАТИЧЕСКОЙ СБОРКИ ЧЕРТЕЖА ===",
        "_STYLE Standard isocpeur.ttf 3.5 1.0 0.0 _N _N",
        "_LAYER _M TX_Equipment _C 2  ",
        "_LAYER _M Title_Block _C 7  ",
        "_RECTANG 0,0 420,297",
        "_RECTANG 20,5 415,292",
        f"_TEXT 25,15 3.5 0 ЗАКАЗЧИК:_ПАО_'{operator}'",
        f"_TEXT 25,25 3.5 0 ОБЪЕКТ:_БС_№{site_id}",
        f"_TEXT 25,35 3.5 0 АДРЕС:_{address.replace(' ', '_')}",
        f"_TEXT 25,45 3.5 0 РАЗРАБОТАЛ:_Поздняков_С.В.",
        "_ZOOM _E",
        "; Конец сценария"
    ]
    
    with open(scr_path, "w", encoding="ansi") as f:
        for cmd in script_commands:
            f.write(cmd + "\n")
    print(f"[Чертежник]: AutoCAD-сценарий сформирован: {scr_path}")

def generate_ai_report(site_id, operator, address):
    """Модуль связи с локальным Qwen 2.5 Coder в LM Studio"""
    output_dir = r"C:\Project\bs_constructor\output"
    report_path = os.path.join(output_dir, f"Act_PPO_{site_id}.txt")
    lm_url = "http://localhost:1234/v1/chat/completions"
    
    # Настраиваем жесткий инженерный промпт под загородную специфику МТС (ОДН)
    prompt_text = (
        f"Ты — ведущий инженер-проектировщик БС связи (ГИП). Напиши подробный технический "
        f"Акт предпроектного обследования (ППО/АОП) для оператора {operator} по объекту БС №{site_id} ({address}). "
        f"Учти специфику: позиция размещается на металлической многогранной опоре ОДН компании 'Русмаркет'. "
        f"Высота подвеса антенн +36.100м. Оборудование: трехдиапазонные радиомодули Huawei RRU5502, "
        f"климатический шкаф 'Интеркросс Тип 5' на подвесной раме Кр-1. Кабели питания 6мм2 и оптика "
        f"прокладываются внутри тела ОДН. Язык строго технический, по ГОСТу, без лишних вводных слов."
    )
    
    payload = {
        "messages": [
            {"role": "system", "content": "Ты профессиональный ГИП телеком-направления, эксперт по ПИР БС."},
            {"role": "user", "content": prompt_text}
        ],
        "temperature": 0.2, # Минимальная фантазия, максимум точности
        "max_tokens": 1500
    }
    
    try:
        data = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(lm_url, data=data, headers={"Content-Type": "application/json"})
        
        print(f"[Локальный ИИ]: Отправка запроса в LM Studio. ИИ генерирует Акт АОП...")
        with urllib.request.urlopen(req) as response:
            res = json.loads(response.read().decode("utf-8"))
            
            # ИСПРАВЛЕННЫЙ БЕЗОПАСНЫЙ РАЗБОР: добавляем [0] для выбора первого ответа из списка choices
            if "choices" in res and len(res["choices"]) > 0:
                choice_data = res["choices"][0]
                if "message" in choice_data:
                    ai_text = choice_data["message"]["content"]
                else:
                    ai_text = choice_data["text"] # на случай старого формата API
            else:
                ai_text = "Ошибка: ИИ вернул пустой ответ или неверную структуру JSON."
            
            if not os.path.exists(output_dir):
                os.makedirs(output_dir)
                
            with open(report_path, "w", encoding="utf-8") as f:
                f.write(ai_text)
            print(f"[Локальный ИИ]: Акт АОП успешно создан: {report_path}")
            
    except Exception as e:
        print(f"\n[Ошибка ИИ]: Не удалось связаться с LM Studio или разобрать ответ.")
        print(f"Технические детали ошибки: {e}")
def main():
    db_path = r"C:\Project\bs_constructor\database\main_tracker.xlsx"
    
    if not os.path.exists(db_path):
        print("[Ошибка]: База данных main_tracker.xlsx не найдена!")
        return
        
    wb = openpyxl.load_workbook(db_path)
    ws = wb["PIR_Core"] # Читаем строго с нашей изолированной вкладки ПИР
    
    print("="*50)
    print("     ИИ-КОНСТРУКТОР 'BS-CONSTRUCTOR' v1.0")
    print("="*50)
    
    # Считываем данные первой рабочей строки (наш МТС Орово)
    # Строка 2: row[0]=№, row[1]=Operator, row[2]=Site_ID, row[3]=Site_Name, row[5]=Address
    row_data = list(ws.iter_rows(min_row=2, max_row=2, values_only=True))[0]
    
    site_id = str(row_data[2])
    operator = str(row_data[1])
    address = str(row_data[5])
    
    print(f"[Система]: Считан объект из базы Excel: БС №{site_id} ({operator})")
    print(f"[Система]: Адрес: {address}")
    print("-"*50)
    
    # Запуск комплексной сборки
    build_autocad_scr(site_id, operator, address)
    generate_ai_report(site_id, operator, address)
    
    print("\n" + "="*50)
    print("КОМПЛЕКСНАЯ СБОРКА ОБЪЕКТА УСПЕШНО ЗАВЕРШЕНА!")
    print("="*50)

if __name__ == "__main__":
    main()
