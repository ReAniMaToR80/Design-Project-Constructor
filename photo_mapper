import os

def generate_ppo_photo_album(site_id, operator):
    project_dir = f"C:\\Project\\bs_constructor\\input\\BS_{site_id}_{operator}"
    photo_dir = os.path.join(project_dir, "FO PPO")
    output_file = f"C:\\Project\\bs_constructor\\output\\Photo_Album_PPO_{site_id}.txt"
    
    print(f"=== МОДУЛЬ АВТОМАТИЧЕСКОЙ АННОТАЦИИ ФОТО ППО БС №{site_id} ===")
    
    # Имитация базы данных распознанных образов ИИ на ППО
    # В реальной системе 2026 года Qwen 2.5 Coder генерирует это на лету по анализу файлов
    mock_ai_recognition = {
        "photo_sec1.jpg": "Сектор №1. Направление излучения (азимут по ЧТП). Привязка к высотной доминанте. Зона Френеля чистая.",
        "photo_sec2.jpg": "Сектор №2. Направление излучения (азимут по ЧТП). Визуальный контроль панорамы крыш.",
        "photo_sec3.jpg": "Сектор №3. Направление излучения (азимут по ЧТП). Фиксация отсутствия затенения ближними зданиями.",
        "photo_ksh_place.jpg": "Проектируемое место установки климатического шкафа. Жест указывает на существующие разгрузочные балки КМ.",
        "photo_vhes_vru.jpg": "Точка присоединения ВЭС. Фиксация вводного автомата, прибора учета и свободных мест на DIN-рейке.",
        "photo_cable_route.jpg": "Направление кабельной трассы. Фиксация существующего кабель-роста и точки прохода (гильзы) сквозь стену."
    }
    
    if not os.path.exists(photo_dir):
        print(f"[Внимание]: Папка с исходными фото не обнаружена. Создаем структуру...")
        os.makedirs(photo_dir)
        # Создадим пустые файлы-пустышки для демонстрации работы скрипта
        for filename in mock_ai_recognition.keys():
            with open(os.path.join(photo_dir, filename), "w") as f:
                f.write("fake_image_data")
                
    album_entries = []
    
    # Считываем реальные файлы из папки
    files_in_folder = os.listdir(photo_dir)
    photo_num = 1
    
    for file in files_in_folder:
        if file.lower().endswith(('.jpg', '.jpeg', '.png')):
            # Если ИИ узнал этот тип кадра — берем его экспертное описание
            description = mock_ai_recognition.get(file, "Фотофиксация конструктивных элементов площадки. Описание генерируется ИИ.")
            
            entry = f"Фото №{photo_num}. Наименование файла: {file}\nОписание узла ППО: {description}\n" + "-"*50
            album_entries.append(entry)
            photo_num += 1
            
    # Сохраняем готовый текстовый альбом для вставки в Word/AutoCAD
    with open(output_file, "w", encoding="utf-8") as out:
        out.write(f"ВЕДОМОСТЬ ФОТОФИКСАЦИИ МАТЕРИАЛОВ ППО ОБЪЕКТА БС №{site_id} ({operator})\n")
        out.write("="*70 + "\n\n")
        out.write("\n\n".join(album_entries))
        
    print(f"[Успешно]: Текстовый альбом фотофиксации ППО сформирован:\n{output_file}")

if __name__ == "__main__":
    # Тестируем на базе нашего МТС Орово
    generate_ppo_photo_album("78-04546", "MTS")
