import os
import openpyxl
import json
import urllib.request
from docx import Document

def ask_qwen_for_section(site_id, operator, address, section_type):
    """Локальный запрос к Qwen 2.5 Coder за профессиональным инженерным текстом"""
    lm_url = "http://localhost:1234/v1/chat/completions"
    
    if section_type == "TX":
        prompt = f"Напиши сухой технический раздел 'Технологические решения БС' для Акта ППО оператора {operator} БС №{site_id} ({address}). Учти: опора ОДН Русмаркет 38м, подвес АФУ Broadradio на +36.1м, 3 радиомодуля Huawei RRU5502 на кронштейнах Кр-2 на отметке +31.1м. Кабели питания КУСИЛнг-FRHF 2х6 и оптика SM DLC-DLC идут внутри ствола ОДН с шагом 800мм крест-накрест. Без вводных слов."
      else:
        prompt = (
            f"Напиши строгий раздел 'Электроснабжение и заземление' для Акта ППО оператора {operator} БС №{site_id}. "
            f"Учти требования: ТУ ВЭС от Русмаркет ограничены максимальной мощностью 5 кВт, трехфазная сеть 0.4кВ. "
            f"Подключение от ВРУ Русмаркет через автомат 16А. Проектируется ЩУ-1 со счетчиком Меркурий АРТ230 и вводным автоматом 10А С. "
            f"Систему заземления выполнить медным проводом ПуГВ 1х16 на существующий контур заземления ОДН. "
            f"Проектом предусмотреть монтаж трех магистральных шин заземления типа ШЗ-1, размещаемых строго на следующих "
            f"высотных проектных отметках: первая шина — на отметке +38.000 м, вторая — на отметке +31.000 м, "
            f"третья — на отметке +2.500 м от уровня земли. Текст должен быть сухим, использовать термины 'высотная отметка', строго по ГОСТ и ПУЭ."
        )

    payload = {
        "messages": [
            {"role": "system", "content": "Ты ведущий ГИП сотовой связи, эксперт по ПИР БС. Пишешь строго по РД, СНиП и ПУЭ."},
            {"role": "user", "content": prompt}
        ],
        "temperature": 0.1,
        "max_tokens": 1000
    }
    
    try:
        data = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(lm_url, data=data, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req) as response:
            res = json.loads(response.read().decode("utf-8"))
            return res["choices"][0]["message"]["content"].strip()
    except Exception as e:
        print(f"[Ошибка ИИ в разделе {section_type}]: {e}")
        return f"Технические данные по разделу {section_type} сформированы автоматически согласно ТЗ."

def build_final_docx(site_id, operator, address):
    base_dir = r"C:\Project\bs_constructor"
    template_path = os.path.join(base_dir, "templates", "02_MTS", "Documents", "template_aop.docx")
    output_dir = os.path.join(base_dir, "output")
    output_path = os.path.join(output_dir, f"AOP_MTS_{site_id}_FINAL.docx")
    
    # 1. Если физического шаблона .docx еще нет, создаем чистый документ на лету
    # (чтобы скрипт не падал при первом запуске, пока вы не закинули туда свой реальный файл)
    if not os.path.exists(template_path):
        print(f"[Система]: Шаблон {template_path} не найден. Генерируем структуру документа с нуля...")
        doc = Document()
        doc.add_heading(f"АКТ ОБСЛЕДОВАНИЯ ПЛОЩАДКИ ОБЪЕКТА СВЯЗИ", 0)
        doc.add_paragraph("Номер позиции: [SITE_ID]")
        doc.add_paragraph("Адрес размещения: [ADDRESS]")
        doc.add_heading("1. Технологические решения (ТХ)", level=1)
        doc.add_paragraph("[AI_TEXT_TX]")
        doc.add_heading("2. Электроснабжение и заземление (ЭМ)", level=1)
        doc.add_paragraph("[AI_TEXT_EM]")
        os.makedirs(os.path.dirname(template_path), exist_ok=True)
        doc.save(template_path)

    # 2. Обращаемся к запущенной в LM Studio модели Qwen 2.5 Coder
    print("[Конструктор]: Опрос локального ИИ для формирования разделов проекта...")
    text_tx = ask_qwen_for_section(site_id, operator, address, "TX")
    text_em = ask_qwen_for_section(site_id, operator, address, "EM")
    
    # 3. Открываем шаблон Word и делаем сквозную замену тегов на реальные данные
    doc = Document(template_path)
    
    # Словарь замен (Единый Источник Данных в действии)
    replacements = {
        "[SITE_ID]": site_id,
        "[ADDRESS]": address,
        "[AI_TEXT_TX]": text_tx,
        "[AI_TEXT_EM]": text_em
    }
    
    # Ищем маркеры в абзацах текста
    for paragraph in doc.paragraphs:
        for tag, value in replacements.items():
            if tag in paragraph.text:
                paragraph.text = paragraph.text.replace(tag, value)
                
    # Ищем маркеры внутри таблиц (если штампы или спецификации оформлены таблицей в Ворде)
    for table in doc.tables:
        for row in table.rows:
            for cell in row.cells:
                for paragraph in cell.paragraphs:
                    for tag, value in replacements.items():
                        if tag in paragraph.text:
                            paragraph.text = paragraph.text.replace(tag, value)
                            
    if not os.path.exists(output_dir):
        os.makedirs(output_dir)
        
    doc.save(output_path)
    print(f"\n[Успешно]: Полный отформатированный том Word сохранен по пути:\n{output_path}")

def main():
    db_path = r"C:\Project\bs_constructor\database\main_tracker.xlsx"
    if not os.path.exists(db_path):
        print("[Ошибка]: База данных трекера не найдена! Запустите init_tracker.py")
        return
        
    wb = openpyxl.load_workbook(db_path)
    ws = wb["PIR_Core"]
    
    # Читаем строку 2 (МТС Орово)
    row_data = list(ws.iter_rows(min_row=2, max_row=2, values_only=True))[0]
    site_id = str(row_data[2])
    operator = str(row_data[1])
    address = str(row_data[5])
    
    build_final_docx(site_id, operator, address)

if __name__ == "__main__":
    main()
